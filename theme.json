{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "纸白"
				},
				{
					"slug": "surface",
					"color": "#f5f4f1",
					"name": "浅底"
				},
				{
					"slug": "sunken",
					"color": "#efeeea",
					"name": "深浅底"
				},
				{
					"slug": "ink",
					"color": "#14130f",
					"name": "墨黑"
				},
				{
					"slug": "text",
					"color": "#1c1b19",
					"name": "正文"
				},
				{
					"slug": "text-soft",
					"color": "#514f4b",
					"name": "次要文字"
				},
				{
					"slug": "muted",
					"color": "#86847e",
					"name": "弱化文字"
				},
				{
					"slug": "accent",
					"color": "#b03a2b",
					"name": "砖红"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "衬线标题",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, \"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", serif"
				},
				{
					"slug": "sans",
					"name": "无衬线正文",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Source Han Sans SC\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "等宽",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.8125rem",
					"name": "小"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "中"
				},
				{
					"slug": "large",
					"size": "1.2rem",
					"name": "大"
				},
				{
					"slug": "x-large",
					"size": "1.6rem",
					"name": "特大"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--text)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "2.7rem",
					"lineHeight": "1.18",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "1.9rem",
					"lineHeight": "1.22",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.2rem",
					"lineHeight": "1.3",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.02rem",
					"lineHeight": "1.4",
					"fontWeight": "700"
				}
			},
			"blockquote": {
				"color": {
					"text": "var(--wp--preset--color--text-soft)"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"typography": {
					"fontStyle": "italic"
				},
				"spacing": {
					"padding": {
						"left": "1.3em"
					}
				}
			},
			"code": {
				"color": {
					"background": "var(--wp--preset--color--sunken)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.85em"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "0.8125rem"
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--sunken)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"radius": "3px",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.85em",
					"lineHeight": "1.65"
				},
				"spacing": {
					"padding": "20px 24px"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"typography": {
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "0.9em"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "报头",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "页脚",
			"area": "footer"
		}
	]
}
