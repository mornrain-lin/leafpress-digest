# 让 git 归档时排除开发专用文件，减小发布包体积。

# 版本控制与构建配置
.gitattributes export-ignore
.gitignore export-ignore

# 项目文档（发布包内保留 README 更有利于使用者理解，这里排除变更日志）
CHANGELOG.md export-ignore

# 翻译模板（.pot 是源文件，编译产物 .mo/.l10n 需要保留）
*.pot export-ignore

# 源码映射与依赖目录
*.map export-ignore
node_modules/ export-ignore
vendor/ export-ignore
